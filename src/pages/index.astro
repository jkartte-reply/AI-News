---
import Base from '../layouts/Base.astro';
import SummaryDashboard from '../components/SummaryDashboard.astro';
import { getReports } from '../lib/reports';

const reports = await getReports();

const sidecars = import.meta.glob<{ default: any }>('../../Reports/*_AI_Weekly.json', { eager: true });
const summaries: Record<string, { intro: string; highlights: string[] } | null> = {};
for (const [path, mod] of Object.entries(sidecars)) {
  const m = path.match(/(\d{4}-\d{2}-\d{2})/);
  if (m) summaries[m[1]] = mod.default?.executive_summary ?? null;
}
---
<Base title="AI Weekly — Übersicht" reports={reports}>
  <SummaryDashboard reports={reports} summaries={summaries} />
</Base>
