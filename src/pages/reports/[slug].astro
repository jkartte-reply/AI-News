---
import Base from '../../layouts/Base.astro';
import Report from '../../components/Report.astro';
import { getReports } from '../../lib/reports';

export async function getStaticPaths() {
  const reports = await getReports();
  return reports.map((r) => ({
    params: { slug: r.slug },
    props: { current: r, reports },
  }));
}

const { current, reports } = Astro.props;
---
<Base title={`AI Weekly — ${current.label}`} reports={reports} activeSlug={current.slug}>
  <Report report={current} indexed />
</Base>
