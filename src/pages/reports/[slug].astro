---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getReports } from '../../lib/reports';

export async function getStaticPaths() {
  const reports = await getReports();
  return reports.map((r) => ({
    params: { slug: r.slug },
    props: { current: r, reports },
  }));
}

const { current, reports } = Astro.props;
const { Content } = await render(current.entry);
---
<Base title={`AI Weekly — ${current.label}`} reports={reports} activeSlug={current.slug}>
  <article class="content-inner" data-pagefind-body>
    <div class="md">
      <Content />
    </div>
  </article>
</Base>
