---
import '../styles/global.css';
import type { ReportMeta } from '../lib/reports';

interface Props {
  title: string;
  reports: ReportMeta[];
  activeSlug?: string;
}

const { title, reports, activeSlug } = Astro.props;
const base = import.meta.env.BASE_URL;            // "/AI-News/"
const reportHref = (slug: string) => `${base}reports/${slug}/`;
const total = reports.length;
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&family=Lora:ital,wght@0,400;0,500;1,400&display=swap"
    rel="stylesheet"
  />
  <link rel="alternate" type="application/rss+xml" title="AI Weekly News" href={`${base}rss.xml`} />
</head>
<body>

<header class="topbar">
  <button class="sidebar-toggle" id="sidebarToggle" aria-label="Navigation">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <line x1="2" y1="4.5" x2="16" y2="4.5" />
      <line x1="2" y1="9" x2="16" y2="9" />
      <line x1="2" y1="13.5" x2="16" y2="13.5" />
    </svg>
  </button>
  <a class="topbar-brand" href={base}>
    <span class="brand-title">AI Weekly</span>
    <span class="brand-issue">Microsoft Partner Edition</span>
  </a>
  <div class="topbar-rule"></div>
  <span class="topbar-meta">KI-Neuigkeiten für AI Engineers</span>
  <a class="topbar-gh" href="https://github.com/jkartte-reply/AI-News" target="_blank" rel="noopener" title="GitHub">
    <svg viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
  </a>
</header>

<div class="layout">
  <nav class="sidebar" id="sidebar">
    <div class="sidebar-top">
      <div class="sidebar-label">Suche</div>
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="6.5" cy="6.5" r="4.5" />
          <line x1="10.5" y1="10.5" x2="14" y2="14" />
        </svg>
        <input
          class="search-input"
          id="searchInput"
          type="search"
          placeholder="Inhalte durchsuchen…"
          autocomplete="off"
          spellcheck="false"
        />
        <button class="search-clear" id="searchClear" aria-label="Suche leeren">×</button>
      </div>
    </div>
    <div class="report-nav">
      <div class="sidebar-label">Alle Reports</div>
      {reports.map((r, i) => (
        <a
          class:list={['nav-item', { active: r.slug === activeSlug }]}
          href={reportHref(r.slug)}
        >
          <span class="nav-num">{total - i}</span>
          <span class="nav-text">
            <span class="nav-date">{r.iso}</span>
            <span class="nav-title">{r.label}</span>
          </span>
          {i === 0 && <span class="badge-new">Neu</span>}
        </a>
      ))}
    </div>
  </nav>

  <main class="content" id="contentArea">
    <div id="reportView"><slot /></div>
    <div id="searchResults" class="content-inner" hidden></div>
  </main>
</div>

<script>
  const toggle = document.getElementById('sidebarToggle');
  const sidebar = document.getElementById('sidebar');
  toggle?.addEventListener('click', () => sidebar?.classList.toggle('open'));
</script>

<script>
  // Custom search UI powered by the Pagefind JS API.
  // Input lives in the sidebar; results render full-width in the content area
  // as cards — the whole card links to the report (clear "click = open report").
  const base = import.meta.env.BASE_URL; // "/AI-News/"
  const DE_MONTHS = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];

  const input = document.getElementById('searchInput') as HTMLInputElement | null;
  const clearBtn = document.getElementById('searchClear');
  const reportView = document.getElementById('reportView');
  const resultsEl = document.getElementById('searchResults');
  const contentArea = document.getElementById('contentArea');

  if (input && clearBtn && reportView && resultsEl && contentArea) {
    let pagefind: any = null;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    const fmtDate = (iso: string) => {
      const [y, m, d] = iso.split('-').map(Number);
      return `${d}. ${DE_MONTHS[m - 1]} ${y}`;
    };
    const fixUrl = (u: string) => {
      const b = base.replace(/\/$/, '');
      return u && u.startsWith('/') && !u.startsWith(b + '/') ? b + u : u;
    };
    const dateFromUrl = (u: string) => {
      const m = u.match(/reports\/(\d{4}-\d{2}-\d{2})/);
      return m ? m[1] : null;
    };

    const showResults = () => { reportView.hidden = true; resultsEl.hidden = false; contentArea.scrollTo(0, 0); };
    const showReport = () => { resultsEl.hidden = true; reportView.hidden = false; resultsEl.innerHTML = ''; };
    const exitSearch = () => { input.value = ''; clearBtn.classList.remove('visible'); showReport(); };

    async function loadPagefind() {
      if (pagefind) return pagefind;
      pagefind = await import(/* @vite-ignore */ `${base}pagefind/pagefind.js`);
      await pagefind.options({ excerptLength: 24 });
      return pagefind;
    }

    function renderResults(results: any[], query: string) {
      showResults();
      const head = (label: string) => `
        <div class="results-hd">
          <div class="results-hd-left">
            <span class="results-label">Suche</span>
            <span class="results-count">${label}</span>
            <span class="results-query">„${escapeHtml(query)}"</span>
          </div>
          <button class="results-close" type="button">Schließen</button>
        </div>`;

      if (!results.length) {
        resultsEl!.innerHTML = `<div class="results-panel">${head('Keine Treffer für')}
          <div class="results-none">Keine Ergebnisse gefunden.<br>
          <strong>Tipp:</strong> Versuche einen kürzeren oder allgemeineren Begriff.</div></div>`;
      } else {
        const cards = results.map((d) => {
          const url = fixUrl(d.url);
          const iso = dateFromUrl(url);
          const label = iso ? fmtDate(iso) : (d.meta?.title || 'Report');
          const subs = (d.sub_results && d.sub_results.length
            ? d.sub_results
            : [{ title: '', excerpt: d.excerpt }]).slice(0, 3);
          const blocks = subs.map((s: any) => `
            ${s.title ? `<span class="result-section">${escapeHtml(s.title)}</span>` : ''}
            <p class="result-snippet">${s.excerpt}</p>`).join('');
          return `<a class="result-card" href="${url}">
            <div class="result-header">
              <span class="result-date-label">${escapeHtml(label)}</span>
              <span class="result-open">Report öffnen <span class="result-arrow">&#8594;</span></span>
            </div>${blocks}</a>`;
        }).join('');
        const noun = results.length === 1 ? 'Report' : 'Reports';
        resultsEl!.innerHTML = `<div class="results-panel">${head(`${results.length} ${noun} für`)}${cards}</div>`;
      }
      resultsEl!.querySelector('.results-close')?.addEventListener('click', exitSearch);
    }

    async function runSearch(query: string) {
      try {
        const pf = await loadPagefind();
        const search = await pf.search(query);
        if (input!.value.trim() !== query) return; // query changed while loading
        const results = await Promise.all(search.results.slice(0, 20).map((r: any) => r.data()));
        renderResults(results, query);
      } catch (e) {
        showResults();
        resultsEl!.innerHTML = `<div class="results-panel"><div class="results-none">
          Suche ist nur im Build verfügbar (<code>npm run build &amp;&amp; npm run preview</code>).</div></div>`;
      }
    }

    input.addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value;
      clearBtn.classList.toggle('visible', v.length > 0);
      clearTimeout(timer);
      const q = v.trim();
      if (q.length < 2) { if (!resultsEl.hidden) showReport(); return; }
      timer = setTimeout(() => {
        if (!pagefind) {
          showResults();
          resultsEl.innerHTML = '<div class="search-loading"><div class="spinner"></div><span>Suche wird vorbereitet…</span></div>';
        }
        runSearch(q);
      }, 300);
    });

    clearBtn.addEventListener('click', () => { exitSearch(); input.focus(); });
    input.addEventListener('keydown', (e) => { if (e.key === 'Escape') exitSearch(); });
  }
</script>

</body>
</html>
