---
import { render } from 'astro:content';
import type { ReportMeta } from '../lib/reports';

interface Props {
  report: ReportMeta;
  indexed?: boolean;
}

// Shared report view used by both the homepage (newest report) and the per-date
// pages. `indexed` adds data-pagefind-body so only the canonical /reports/<date>/
// page is picked up by the search index (homepage stays out of the index).
const { report, indexed = false } = Astro.props;
const { Content } = await render(report.entry);
---
<div class="report-shell">
  <details class="toc" id="toc" data-pagefind-ignore hidden>
    <summary class="toc-summary">Auf dieser Seite</summary>
    <nav class="toc-nav" id="tocNav" aria-label="Inhaltsverzeichnis"></nav>
  </details>

  <article class="content-inner" data-pagefind-body={indexed ? true : undefined}>
    <!-- Print-only header (hidden on screen, shown in print/PDF) -->
    <div class="print-head" aria-hidden="true">
      <span class="print-head-brand">AI Weekly · Microsoft Partner Edition</span>
      <span class="print-head-date">{report.label}</span>
    </div>

    <div class="rel-filter" data-pagefind-ignore>
      <span class="rel-filter-label">Filter:</span>
      <div class="rel-dd" id="relDd">
        <button class="rel-dd-btn" type="button" id="relDdBtn" aria-haspopup="true" aria-expanded="false">
          <span id="relDdText">Alle</span>
          <svg class="rel-dd-chevron" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M1 1l4 4 4-4"/>
          </svg>
        </button>
        <div class="rel-dd-panel" id="relDdPanel" hidden>
          <label class="rel-opt">
            <input type="checkbox" value="high" checked>
            <span class="rb rb-high">Hoch</span>
          </label>
          <label class="rel-opt">
            <input type="checkbox" value="medium" checked>
            <span class="rb rb-mid">Mittel</span>
          </label>
          <label class="rel-opt">
            <input type="checkbox" value="low" checked>
            <span class="rb rb-low">Gering</span>
          </label>
        </div>
      </div>
    </div>

    <div class="md">
      <Content />
    </div>

    <footer class="report-footer" data-pagefind-ignore>
      <button class="print-btn" id="printBtn" type="button" aria-label="Report drucken oder als PDF speichern">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6V2h8v4" />
          <path d="M4 12H2.5A1.5 1.5 0 0 1 1 10.5v-3A1.5 1.5 0 0 1 2.5 6h11A1.5 1.5 0 0 1 15 7.5v3a1.5 1.5 0 0 1-1.5 1.5H12" />
          <rect x="4" y="10" width="8" height="4" rx="0.5" />
        </svg>
        <span>Drucken / Als PDF</span>
      </button>
    </footer>
  </article>
</div>

<script>
  document.getElementById('printBtn')?.addEventListener('click', () => window.print());
</script>

<script>
  // Relevanz-Badges + Filter (#08)
  // Replace 🔴/🟡/🟢 emoji in .md with styled badge spans, tag tbody rows with
  // data-relevance, then wire up the filter buttons above the report.
  (function () {
    const md = document.querySelector<HTMLElement>('.md');
    if (!md) return;

    const BADGE: Record<string, [string, string]> = {
      '🔴': ['rb-high', 'Hoch'],
      '🟡': ['rb-mid',  'Mittel'],
      '🟢': ['rb-low',  'Gering'],
    };

    // Replace every relevance emoji in text nodes with a badge <span>.
    const walker = document.createTreeWalker(md, NodeFilter.SHOW_TEXT, {
      acceptNode(node) {
        if (!/[🔴🟡🟢]/u.test(node.nodeValue || '')) return NodeFilter.FILTER_REJECT;
        const p = (node as Text).parentElement;
        if (!p || p.closest('code, pre')) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      },
    });

    const targets: Text[] = [];
    let n: Node | null;
    while ((n = walker.nextNode())) targets.push(n as Text);

    for (const textNode of targets) {
      const value = textNode.nodeValue || '';
      const frag = document.createDocumentFragment();
      let last = 0;
      for (const m of value.matchAll(/[🔴🟡🟢]/gu)) {
        const idx = m.index!;
        const entry = BADGE[m[0]];
        if (idx > last) frag.appendChild(document.createTextNode(value.slice(last, idx)));
        if (entry) {
          const span = document.createElement('span');
          span.className = `rb ${entry[0]}`;
          span.textContent = entry[1];
          frag.appendChild(span);
        } else {
          frag.appendChild(document.createTextNode(m[0]));
        }
        last = idx + m[0].length;
      }
      if (last < value.length) frag.appendChild(document.createTextNode(value.slice(last)));
      textNode.parentNode?.replaceChild(frag, textNode);
    }

    // Tag each tbody <tr> with data-relevance based on the badge it contains.
    for (const row of Array.from(md.querySelectorAll<HTMLTableRowElement>('tbody tr'))) {
      const badge = row.querySelector('.rb-high, .rb-mid, .rb-low');
      if (badge) {
        row.dataset.relevance = badge.classList.contains('rb-high') ? 'high'
          : badge.classList.contains('rb-mid') ? 'medium' : 'low';
      }
    }

    // Relevanz dropdown filter.
    const dd     = document.getElementById('relDd');
    const ddBtn  = document.getElementById('relDdBtn') as HTMLButtonElement | null;
    const ddPanel = document.getElementById('relDdPanel') as HTMLElement | null;
    const ddText = document.getElementById('relDdText') as HTMLElement | null;

    if (ddBtn && ddPanel && ddText) {
      const rows = Array.from(md.querySelectorAll<HTMLTableRowElement>('tbody tr[data-relevance]'));
      const cbs  = Array.from(ddPanel.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
      const LABEL: Record<string, string> = { high: 'Hoch', medium: 'Mittel', low: 'Gering' };

      const applyFilter = () => {
        const checked = new Set(cbs.filter((c) => c.checked).map((c) => c.value));
        const all = checked.size === cbs.length;
        for (const row of rows) {
          row.style.display = (all || checked.has(row.dataset.relevance || '')) ? '' : 'none';
        }
        ddText.textContent = all ? 'Alle'
          : checked.size === 0 ? 'Keine'
          : [...checked].map((v) => LABEL[v] || v).join(', ');
      };

      cbs.forEach((cb) => cb.addEventListener('change', applyFilter));

      ddBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = ddPanel.hidden;
        ddPanel.hidden = !open;
        ddBtn.setAttribute('aria-expanded', String(open));
      });

      document.addEventListener('click', (e) => {
        if (!dd?.contains(e.target as Node)) {
          ddPanel.hidden = true;
          ddBtn.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !ddPanel.hidden) {
          ddPanel.hidden = true;
          ddBtn.setAttribute('aria-expanded', 'false');
          ddBtn.focus();
        }
      });
    }
  })();
</script>

<script>
  // Section anchors (#10): each h2/h3 (id set at build time by rehypeHeadingIds)
  // gets a hover link button that copies its deep-link to the clipboard.
  // On load / hashchange we scroll the matching section into view — needed
  // because the content scrolls inside #contentArea, not the document.
  const headings = document.querySelectorAll<HTMLElement>('.md h2[id], .md h3[id]');

  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch {}
      document.body.removeChild(ta);
      return ok;
    }
  };

  headings.forEach((h) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'section-anchor';
    btn.setAttribute('aria-label', 'Link zu diesem Abschnitt kopieren');
    btn.innerHTML = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 8.5a2.5 2.5 0 0 0 3.5 0l2-2a2.5 2.5 0 0 0-3.5-3.5l-1 1"/><path d="M9.5 7.5a2.5 2.5 0 0 0-3.5 0l-2 2a2.5 2.5 0 0 0 3.5 3.5l1-1"/></svg>';
    btn.addEventListener('click', async () => {
      const url = `${location.origin}${location.pathname}#${h.id}`;
      const ok = await copy(url);
      history.replaceState(null, '', `#${h.id}`);
      btn.classList.add(ok ? 'copied' : 'copy-failed');
      setTimeout(() => btn.classList.remove('copied', 'copy-failed'), 1400);
    });
    h.appendChild(btn);
  });

  const scrollToHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(id);
    if (el) requestAnimationFrame(() => el.scrollIntoView({ behavior: 'smooth', block: 'start' }));
  };
  if (location.hash) scrollToHash();
  window.addEventListener('hashchange', scrollToHash);
</script>

<script>
  // Table of contents (#09): built from the section headings, sticky beside the
  // report on wide screens, collapsible on mobile. Active section is highlighted
  // while scrolling via IntersectionObserver (root = #contentArea scroll box).
  const toc = document.getElementById('toc') as HTMLDetailsElement | null;
  const tocNav = document.getElementById('tocNav');
  const area = document.getElementById('contentArea');
  const headings = Array.from(
    document.querySelectorAll<HTMLElement>('.md h2[id], .md h3[id]')
  );

  if (toc && tocNav && headings.length >= 3) {
    const linkFor = new Map<string, HTMLAnchorElement>();
    for (const h of headings) {
      const a = document.createElement('a');
      a.className = `toc-link toc-${h.tagName.toLowerCase()}`;
      a.href = `#${h.id}`;
      // Use only the heading's own text, ignoring the injected anchor button.
      a.textContent = (h.childNodes[0]?.textContent || h.textContent || '').trim();
      a.addEventListener('click', (e) => {
        e.preventDefault();
        history.replaceState(null, '', `#${h.id}`);
        h.scrollIntoView({ behavior: 'smooth', block: 'start' });
        if (toc.open && window.matchMedia('(max-width: 1199px)').matches) toc.open = false;
      });
      tocNav.appendChild(a);
      linkFor.set(h.id, a);
    }

    toc.hidden = false;
    // Open by default on wide screens (sticky rail), collapsed on mobile.
    const wide = window.matchMedia('(min-width: 1200px)');
    toc.open = wide.matches;
    wide.addEventListener('change', (e) => { toc.open = e.matches; });

    let activeId = '';
    const setActive = (id: string) => {
      if (id === activeId) return;
      if (activeId) linkFor.get(activeId)?.classList.remove('active');
      activeId = id;
      linkFor.get(id)?.classList.add('active');
    };
    const observer = new IntersectionObserver(
      (entries) => {
        // Pick the heading nearest the top edge of the viewport band.
        const visible = entries
          .filter((en) => en.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length) setActive((visible[0].target as HTMLElement).id);
      },
      { root: area, rootMargin: '0px 0px -78% 0px', threshold: 0 }
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>

<script>
  // Search-term highlighting (#04): when a report is opened from a search result
  // its URL carries ?q=<term>. We mark every occurrence in the report body and
  // scroll the first one into view. Opening a report normally (no ?q=) → no marks.
  const md = document.querySelector<HTMLElement>('.md');
  const q = new URLSearchParams(location.search).get('q');
  if (md && q) {
    const tokens = q.trim().split(/\s+/).filter((t) => t.length >= 2)
      .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
    if (tokens.length) {
      const re = new RegExp(`(${tokens.join('|')})`, 'gi');
      const walker = document.createTreeWalker(md, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
          const p = (node as Text).parentElement;
          if (!p || p.closest('mark, code, pre, .section-anchor')) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        },
      });

      const targets: Text[] = [];
      let n: Node | null;
      while ((n = walker.nextNode())) targets.push(n as Text);

      let first: HTMLElement | null = null;
      for (const textNode of targets) {
        const value = textNode.nodeValue || '';
        if (!re.test(value)) continue;
        re.lastIndex = 0;
        const frag = document.createDocumentFragment();
        let last = 0;
        for (const m of value.matchAll(re)) {
          const idx = m.index ?? 0;
          if (idx > last) frag.appendChild(document.createTextNode(value.slice(last, idx)));
          const mark = document.createElement('mark');
          mark.className = 'search-hl';
          mark.textContent = m[0];
          if (!first) first = mark;
          frag.appendChild(mark);
          last = idx + m[0].length;
        }
        if (last < value.length) frag.appendChild(document.createTextNode(value.slice(last)));
        textNode.parentNode?.replaceChild(frag, textNode);
      }

      if (first) {
        first.classList.add('search-hl-first');
        requestAnimationFrame(() => first!.scrollIntoView({ behavior: 'smooth', block: 'center' }));
      }
    }
  }
</script>
