---
import { render } from 'astro:content';
import type { ReportMeta } from '../lib/reports';

interface Props {
  report: ReportMeta;
  indexed?: boolean;
}

// Shared report view used by both the homepage (newest report) and the per-date
// pages. `indexed` adds data-pagefind-body so only the canonical /reports/<date>/
// page is picked up by the search index (homepage stays out of the index).
const { report, indexed = false } = Astro.props;
const { Content } = await render(report.entry);
---
<div class="report-shell">
  <article class="content-inner" data-pagefind-body={indexed ? true : undefined}>
    <!-- Print-only header (hidden on screen, shown in print/PDF) -->
    <div class="print-head" aria-hidden="true">
      <span class="print-head-brand">AI Weekly · Microsoft Partner Edition</span>
      <span class="print-head-date">{report.label}</span>
    </div>

    <div class="md">
      <Content />
    </div>

    <footer class="report-footer" data-pagefind-ignore>
      <button class="print-btn" id="printBtn" type="button" aria-label="Report drucken oder als PDF speichern">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6V2h8v4" />
          <path d="M4 12H2.5A1.5 1.5 0 0 1 1 10.5v-3A1.5 1.5 0 0 1 2.5 6h11A1.5 1.5 0 0 1 15 7.5v3a1.5 1.5 0 0 1-1.5 1.5H12" />
          <rect x="4" y="10" width="8" height="4" rx="0.5" />
        </svg>
        <span>Drucken / Als PDF</span>
      </button>
    </footer>
  </article>
</div>

<script>
  document.getElementById('printBtn')?.addEventListener('click', () => window.print());
</script>
