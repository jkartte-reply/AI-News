---
import type { ReportMeta } from '../lib/reports';

interface ExecSummary {
  intro: string;
  highlights: string[];
}

interface Props {
  reports: ReportMeta[];
  summaries: Record<string, ExecSummary | null>;
}

const { reports, summaries } = Astro.props;
const base = import.meta.env.BASE_URL;
const total = reports.length;
---

<div class="summary-page">
  <header class="summary-hd">
    <h1 class="summary-hd-title">AI Weekly — Übersicht</h1>
    <p class="summary-hd-sub">{total} Reports · KI-Neuigkeiten für AI Engineers im Microsoft Partner Umfeld</p>
  </header>

  <div class="summary-feed">
    {reports.map((r, i) => {
      const summary = summaries[r.iso] ?? null;
      const href = `${base}reports/${r.slug}/`;
      const num = total - i;
      return (
        <article class:list={['summary-card', i === 0 && 'summary-card--latest']}>
          <div class="sc-meta">
            <span class="sc-num">#{num}</span>
            <time class="sc-date" datetime={r.iso}>{r.label}</time>
            {i === 0 && <span class="sc-badge-new">Neu</span>}
          </div>

          {summary ? (
            <div class="sc-body">
              <p class="sc-intro">{summary.intro}</p>
              <ul class="sc-highlights">
                {summary.highlights.map((h) => {
                  const ci = h.indexOf(':');
                  if (ci > 0 && ci < 50) {
                    return <li><strong>{h.slice(0, ci)}:</strong> {h.slice(ci + 1).trim()}</li>;
                  }
                  return <li>{h}</li>;
                })}
              </ul>
            </div>
          ) : (
            <p class="sc-fallback">Kein Executive Summary verfügbar.</p>
          )}

          <a class="sc-link" href={href}>
            Report lesen <span class="sc-arrow" aria-hidden="true">→</span>
          </a>
        </article>
      );
    })}
  </div>
</div>

<style>
  .summary-page {
    padding: 2rem 2.5rem 4rem;
    max-width: 820px;
  }

  .summary-hd {
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .summary-hd-title {
    font-family: 'Instrument Serif', serif;
    font-size: 2rem;
    font-weight: 400;
    color: var(--ink);
    margin: 0 0 0.35rem;
    line-height: 1.15;
  }

  .summary-hd-sub {
    font-size: 0.875rem;
    color: var(--ink-3);
    margin: 0;
  }

  .summary-feed {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .summary-card {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-left-width: 3px;
    border-left-color: transparent;
    border-radius: 6px;
    padding: 1.25rem 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.15s, background 0.15s;
  }

  .summary-card--latest {
    border-left-color: var(--green);
  }

  .summary-card:hover {
    border-color: var(--green);
    background: var(--paper-3);
  }

  .sc-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .sc-num {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-4);
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .sc-date {
    font-family: 'Instrument Serif', serif;
    font-size: 1.1rem;
    color: var(--ink);
    flex: 1;
  }

  .sc-badge-new {
    font-size: 0.68rem;
    font-weight: 600;
    background: var(--green);
    color: #fff;
    padding: 0.15em 0.6em;
    border-radius: 20px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .sc-intro {
    font-family: 'Lora', serif;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
  }

  .sc-highlights {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sc-highlights li {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .sc-highlights strong {
    color: var(--ink);
    font-weight: 600;
  }

  .sc-fallback {
    font-size: 0.875rem;
    color: var(--ink-3);
    font-style: italic;
    margin: 0;
  }

  .sc-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--green);
    text-decoration: none;
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.25rem;
  }

  .sc-link:hover {
    text-decoration: underline;
  }

  .sc-arrow {
    display: inline-block;
    transition: transform 0.15s;
  }

  .sc-link:hover .sc-arrow {
    transform: translateX(3px);
  }

  [data-theme="dark"] .summary-card:hover {
    background: var(--paper-3);
  }

  [data-theme="dark"] .sc-badge-new {
    color: var(--paper);
  }

  @media (max-width: 640px) {
    .summary-page {
      padding: 1.25rem 1rem 3rem;
    }
    .summary-hd-title {
      font-size: 1.5rem;
    }
    .summary-card {
      padding: 1rem 1.1rem 0.875rem;
    }
  }
</style>
